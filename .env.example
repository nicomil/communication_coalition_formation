# Esempio .env per sviluppo locale — copia come .env (non committare)
# Produzione: variabili su Heroku, vedi docs/PROLIFIC_PILOT_RUNBOOK.md

# --- Staff / admin oTree ---
OTREE_ADMIN_PASSWORD=password_sviluppo

# --- Test locale flusso blindato (decommenta, poi: otree devserver) ---
# OTREE_AUTH_LEVEL=STUDY
# OTREE_PRODUCTION=1
# PROLIFIC_COMPLETION_URL=https://app.prolific.com/submissions/complete?cc=<CODE>

# --- Produzione pilot Prolific (Heroku: tutte obbligatorie) ---
# OTREE_PRODUCTION=1
# OTREE_AUTH_LEVEL=STUDY
# SECRET_KEY=<python -c 'import secrets; print(secrets.token_urlsafe(50))'>
# PROLIFIC_COMPLETION_URL=https://app.prolific.com/submissions/complete?cc=<CODE>

# DATABASE_URL=postgresql://...  # Heroku imposta automaticamente
