. * Utility program: prints a pairwise comparison header
. *----------------------------------------------------------------------------
> --
. capture program drop pair_header

. program define pair_header
  1.     args lab1 lab2
  2.     display as result _newline "  -- `lab1'  vs  `lab2' --"
  3. end

